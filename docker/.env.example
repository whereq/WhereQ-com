# =============================================================================
# whereq.com — Docker environment
# =============================================================================
# Copy to docker/.env and fill in. The compose file reads this file
# automatically (docker/.env is the project directory for
# `docker compose -f docker/docker-compose.yml`).
#
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored. Never commit real values.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────
# The bundled PostGIS container. Change the password before exposing this
# stack to anything but your own machine.
POSTGRES_USER=whereq
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=whereq

# ── Security ─────────────────────────────────────────────────────────────
# A random 64-character string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The app runs with APP_ENV=production, and it refuses to start on a
# placeholder — so change this before the first `docker compose up`.
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Google Maps (optional) ───────────────────────────────────────────────
# Browser key (referrer-locked) and a SEPARATE server key with no referrer
# restriction. Both are optional — the map degrades without them.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=

# ── whereq.cloud (optional) ──────────────────────────────────────────────
# The platform that collects the data: the fuel stations, the prices, the
# administrative geography, the schools and the local content. Without a key
# the public demo preview is used (oldest 100 rows).
WHEREQ_CLOUD_API_KEY=
# The key's own rate limit, in requests per minute. The free tier is 30; a
# paid key allows more, and the client limiter follows this number.
WHEREQ_CLOUD_RATE_LIMIT_PER_MIN=30

# ── Which copy of each feed the API reads ────────────────────────────────
# local | dual | cloud. "cloud" reads whereq.cloud directly, which is the
# default: the platform collects the data, so this app does not keep a
# second copy. "dual" compares the two on every read and serves the local
# answer; "local" serves this app's own mirror.
CLOUD_READ_MODE=cloud
# The outlines have their own switch (they are served in bulk). Empty means
# "follow CLOUD_READ_MODE".
GEO_BOUNDARIES_READ_MODE=
SCHOOL_READ_MODE=cloud
FUEL_READ_MODE=cloud

# ── The mirrors (off — they are the rollback) ─────────────────────────────
# Turning these on keeps a second copy of the data in this app's database.
FUEL_MIRROR_ENABLED=false
GEO_INGEST_ENABLED=false
# The legacy collectors: the RSS crawl and the Overpass POI ingest.
LEGACY_COLLECTORS_ENABLED=false

# ── Authentication (optional) ────────────────────────────────────────────
# Leave KEYCLOAK_URL EMPTY to run without authentication. Point it at your
# own OIDC realm to enable sign-in — the walkthrough is in docs/SETUP.md.
KEYCLOAK_URL=
KEYCLOAK_REALM=whereq
KEYCLOAK_CLIENT_ID=whereq-spa
KEYCLOAK_ADMIN_CLIENT_ID=whereq-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── Geocoding providers (optional) ───────────────────────────────────────
# Free tiers first, Google last. Unconfigured providers are skipped.
GEOCODE_PROVIDER_ORDER=geocode_maps_co,locationiq,geocodio,nominatim,google
GEOCODE_REGION_BIAS=ca
GEOCODE_COUNTRY=CA
# Required by the OSM usage policy for Nominatim.
NOMINATIM_EMAIL=
NOMINATIM_RPS=1.0
GEOCODIO_API_KEY=
LOCATIONIQ_API_KEY=
GEOCODE_MAPS_CO_API_KEY=
POSITIONSTACK_API_KEY=

# ── The consumer container ───────────────────────────────────────────────
# The two reads that pull the platform's rows into the local tables: the
# news feed at the head, and the POI catalogue whole.
LOCAL_CONTENT_SYNC_ENABLED=true
LOCAL_CONTENT_SYNC_CHECK_SECONDS=300
LOCAL_CONTENT_SYNC_PAGES=5
LOCAL_CONTENT_SYNC_PAGE_SIZE=100
LOCAL_PLACES_SYNC_ENABLED=true
LOCAL_PLACES_SYNC_CHECK_SECONDS=3600
LOCAL_PLACES_SYNC_INTERVAL_HOURS=168
LOCAL_PLACES_SYNC_MAX_ROWS=100000

# ── Scheduler ────────────────────────────────────────────────────────────
CRAWLER_ENABLED=true
CRAWLER_TICK_SECONDS=300
CRAWLER_RETENTION_SECONDS=3600
CRAWLER_SEED_ON_START=true

# ── Fuel stations (the mirror) ───────────────────────────────────────────
FUEL_INGEST_ENABLED=true
FUEL_INGEST_TARGETS=CA,US
FUEL_INGEST_TARGETS_PER_TICK=1
FUEL_INGEST_CHECK_SECONDS=3600
FUEL_INGEST_INTERVAL_HOURS=6
FUEL_INGEST_PAGE_SIZE=500
FUEL_INGEST_MAX_STATIONS=60000
FUEL_INGEST_MIN_INTERVAL=2.2
FUEL_INGEST_MAX_RETRIES=5
FUEL_PRICES_ENABLED=true
FUEL_PRICES_REGIONS=ca,us
FUEL_PRICES_INTERVAL_HOURS=24
FUEL_PRICES_CHECK_SECONDS=3600

# ── Administrative geography (the mirror) ────────────────────────────────
GEO_INGEST_TARGETS=bbox:-80.3,43.6,-79.2,44.2
GEO_INGEST_TARGETS_PER_TICK=1
GEO_INGEST_CHECK_SECONDS=21600
GEO_INGEST_INTERVAL_HOURS=168
GEO_INGEST_PAGE_SIZE=200
GEO_INGEST_MAX_PLACES=5000
GEO_INGEST_FETCH_BOUNDARIES=true
GEO_INGEST_MIN_INTERVAL=2.2
GEO_INGEST_MAX_RETRIES=5
GEO_BOUNDARY_SIMPLIFY_M=50.0

# ── OpenStreetMap POIs (the legacy Overpass sweep) ──────────────────────
POI_INGEST_ENABLED=true
POI_INGEST_CHECK_SECONDS=86400
POI_INGEST_INTERVAL_DAYS=7
