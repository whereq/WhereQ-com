# =============================================================================
# whereq.com — Docker environment
# =============================================================================
# Copy to docker/.env and fill in. The compose file reads this file
# automatically (docker/.env is the project directory for
# `docker compose -f docker/docker-compose.yml`).
#
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored. Never commit real values.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────
# The bundled PostGIS container. Change the password before exposing this
# stack to anything but your own machine.
POSTGRES_USER=whereq
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=whereq

# ── Security ─────────────────────────────────────────────────────────────
# A random 64-character string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Google Maps (optional) ───────────────────────────────────────────────
# Browser key (referrer-locked) and a SEPARATE server key with no referrer
# restriction. Both are optional — the map degrades without them.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=

# ── whereq.cloud (optional) ──────────────────────────────────────────────
# The upstream the crawler pulls from: fuel stations, prices and
# administrative geography. Without a key the public demo preview is used
# (oldest 100 rows).
WHEREQ_CLOUD_API_KEY=

# ── Authentication (optional) ────────────────────────────────────────────
# Leave KEYCLOAK_URL EMPTY to run without authentication. Point it at your
# own OIDC realm to enable sign-in — the walkthrough is in docs/SETUP.md.
KEYCLOAK_URL=
KEYCLOAK_REALM=whereq
KEYCLOAK_CLIENT_ID=whereq-spa
KEYCLOAK_ADMIN_CLIENT_ID=whereq-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=
