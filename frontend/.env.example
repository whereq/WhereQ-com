VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id
VITE_API_URL=/api

# ── Authentication (optional) ────────────────────────────────────────────
# Leave VITE_KEYCLOAK_URL EMPTY to run the app in anonymous mode: browsing
# works, sign-in is hidden. To enable sign-in, point these at your own
# OIDC realm — see docs/KEYCLOAK_SETUP.md.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=whereq
VITE_KEYCLOAK_CLIENT_ID=whereq-spa
