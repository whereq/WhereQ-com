# ─── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 15+ with the PostGIS extension. The bundled compose file
# provides one — see docker/docker-compose.yml.
#
# These are the local development defaults. A real deployment must set its own
# connection string: in APP_ENV=production the app refuses to start while
# DATABASE_URL is still this default.
DATABASE_URL=postgresql+asyncpg://whereq:whereq@localhost:5432/whereq
DATABASE_URL_SYNC=postgresql://whereq:whereq@localhost:5432/whereq

# ─── Security ───────────────────────────────────────────────────────────────
# Legacy local JWT settings. Kept for the password helpers only — the app
# does not issue its own sessions. Use a random 64-character value.
#
# In production the app refuses to start on an empty or placeholder value.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Authentication (optional) ──────────────────────────────────────────────
# Leave KEYCLOAK_URL EMPTY to run without authentication: the public
# browsing endpoints work and every protected endpoint answers 401.
# To enable sign-in, point these at your own OIDC realm — the walkthrough
# is in docs/SETUP.md.
KEYCLOAK_URL=
KEYCLOAK_REALM=whereq
KEYCLOAK_CLIENT_ID=whereq-spa
# Confidential service-account client for the OIDC Admin REST calls (e.g.
# role assignment). Leave the secret blank if the deployment does not use it.
KEYCLOAK_ADMIN_CLIENT_ID=whereq-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3743","http://localhost:5173"]

# ─── Google Maps ────────────────────────────────────────────────────────────
# The browser key, with an HTTP-referrer restriction. The backend cannot use
# it: Google rejects a referrer-locked key on a web-service call with
# API_KEY_HTTP_REFERRER_BLOCKED. That is why GOOGLE_MAPS_SERVER_KEY exists —
# a second key with no referrer restriction, restricted by IP and/or API
# allowlist instead. Falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ─── whereq.cloud (the platform that collects the data) ─────────────────────
# The key for the Data API. It is used server-side only — it never reaches
# the browser. Public access is a demo preview (oldest 100 rows); a
# wq_live_… key unlocks the full, live dataset.
WHEREQ_CLOUD_API_KEY=
# The key's own rate limit, in requests per minute. whereq.cloud enforces a
# sliding 60-second window per key, and the limit is the key's tier: the
# free tier is 30. The client-side limiter follows this number, so raise it
# if your key is on a higher tier.
WHEREQ_CLOUD_RATE_LIMIT_PER_MIN=30
WHEREQ_CLOUD_TIMEOUT=60

# ─── Which copy of each feed the API reads ──────────────────────────────────
# local | dual | cloud.
#
#   "local" — this app's own mirror.
#   "dual" — read BOTH the mirror and whereq.cloud, compare them on every
#            read, and serve the LOCAL answer.
#   "cloud" — read whereq.cloud directly.
#
# The default is "cloud" for all of them: whereq.cloud collects the data, so
# this app reads it from there rather than keeping a second copy that goes
# stale. Set one to "local" only if you turned the matching mirror on below.
CLOUD_READ_MODE=cloud
# The outlines have their own switch, because they are served in bulk — a
# viewport's worth in one request — rather than one place at a time.
# Empty means "follow CLOUD_READ_MODE".
GEO_BOUNDARIES_READ_MODE=
SCHOOL_READ_MODE=cloud
FUEL_READ_MODE=cloud

# ─── The mirrors (off by default — they are the rollback) ───────────────────
# The fuel mirror copies the stations and the price series into this app's
# own tables. Off: the fuel data is read live from whereq.cloud.
FUEL_MIRROR_ENABLED=false
# The geography mirror copies the administrative areas and their outlines.
# Off: the geography is read live from whereq.cloud.
GEO_INGEST_ENABLED=false
# The legacy collectors — the RSS crawl and the Overpass POI ingest — are
# off because whereq.cloud collects both now. Set this to true to put them
# back, and only one of the two collectors may run at a time.
LEGACY_COLLECTORS_ENABLED=false

# ─── The consumer container ─────────────────────────────────────────────────
# These two reads pull the platform's rows into the local tables: the news
# feed at the head (it grows all day, and the rows behind it are already
# here), and the POI catalogue whole (the upstream's weekly sweep restamps
# every row, so there is no "changed since" marker).
LOCAL_CONTENT_SYNC_ENABLED=true
LOCAL_CONTENT_SYNC_CHECK_SECONDS=300
LOCAL_CONTENT_SYNC_PAGES=5
LOCAL_CONTENT_SYNC_PAGE_SIZE=100
LOCAL_PLACES_SYNC_ENABLED=true
LOCAL_PLACES_SYNC_CHECK_SECONDS=3600
LOCAL_PLACES_SYNC_INTERVAL_HOURS=168
LOCAL_PLACES_SYNC_MAX_ROWS=100000

# ─── Scheduler ──────────────────────────────────────────────────────────────
CRAWLER_ENABLED=true
CRAWLER_TICK_SECONDS=300
CRAWLER_RETENTION_SECONDS=3600
CRAWLER_SEED_ON_START=true

# ─── Fuel stations (the mirror) ─────────────────────────────────────────────
# Coverage targets, crawled round-robin so one tick never pulls everything.
# One of: CC | CC:State | CC:State:Municipality | bbox:minLon,minLat,maxLon,maxLat
FUEL_INGEST_ENABLED=true
FUEL_INGEST_TARGETS=CA,US
FUEL_INGEST_TARGETS_PER_TICK=1
FUEL_INGEST_CHECK_SECONDS=3600
FUEL_INGEST_INTERVAL_HOURS=6
# Rows per API page (max 500) and the safety cap per target.
FUEL_INGEST_PAGE_SIZE=500
FUEL_INGEST_MAX_STATIONS=60000
FUEL_INGEST_MIN_INTERVAL=2.2
FUEL_INGEST_MAX_RETRIES=5
# Aggregated price series (EIA weekly US / StatCan monthly CA / CRE MX).
FUEL_PRICES_ENABLED=true
FUEL_PRICES_REGIONS=ca,us
FUEL_PRICES_INTERVAL_HOURS=24
FUEL_PRICES_CHECK_SECONDS=3600

# ─── Administrative geography (the mirror) ──────────────────────────────────
# The areas that *contain* the places on the map, with real outlines.
# Grammar per target: "kind:<concept>" | "kind:<concept>:<country>" |
# "country:<CC>" | "source:<name>" | "bbox:minLon,minLat,maxLon,maxLat".
GEO_INGEST_TARGETS=bbox:-80.3,43.6,-79.2,44.2
GEO_INGEST_TARGETS_PER_TICK=1
GEO_INGEST_CHECK_SECONDS=21600
GEO_INGEST_INTERVAL_HOURS=168
GEO_INGEST_PAGE_SIZE=200
GEO_INGEST_MAX_PLACES=5000
# Fetch each place's outline as well as the row. This is the expensive half
# (one API request per place), and it is also the whole point — an outline is
# what turns a name into an area on the map.
GEO_INGEST_FETCH_BOUNDARIES=true
GEO_INGEST_MIN_INTERVAL=2.2
GEO_INGEST_MAX_RETRIES=5
# How much an outline is simplified when it is *served*, in metres. The
# stored geometry is full resolution — the point-in-polygon test must not be
# fooled by a simplified edge.
GEO_BOUNDARY_SIMPLIFY_M=50.0

# ─── OpenStreetMap POIs (the legacy Overpass sweep) ────────────────────────
# The map's Local Essentials and Quick Categories. Re-crawled only when the
# newest OSM row is older than the interval. Off by default — whereq.cloud's
# own sweep provides the POI catalogue now.
POI_INGEST_ENABLED=true
POI_INGEST_CHECK_SECONDS=86400
POI_INGEST_INTERVAL_DAYS=7

# ─── Geocoding ──────────────────────────────────────────────────────────────
# Multi-provider, free tiers first then Google. Set a key for each free
# provider you want to use; unconfigured providers are skipped.
GEOCODE_PROVIDER_ORDER=geocode_maps_co,locationiq,geocodio,nominatim,google
GEOCODE_REGION_BIAS=ca
GEOCODE_COUNTRY=CA
# Required by the OSM usage policy for Nominatim.
NOMINATIM_EMAIL=
NOMINATIM_RPS=1.0
GEOCODIO_API_KEY=
LOCATIONIQ_API_KEY=
GEOCODE_MAPS_CO_API_KEY=
POSITIONSTACK_API_KEY=

# ─── Nearby search ──────────────────────────────────────────────────────────
NEARBY_DEFAULT_RADIUS_KM=5
NEARBY_MAX_RADIUS_KM=50

# ─── LocationIQ ─────────────────────────────────────────────────────────────
LOCATION_IQ_TOKEN=
