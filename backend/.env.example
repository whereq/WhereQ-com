# ── Database ─────────────────────────────────────────────────────────────
# Any PostgreSQL 15+ with the PostGIS extension. The bundled compose file
# provides one — see docker/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://whereq:whereq@localhost:5432/whereq
DATABASE_URL_SYNC=postgresql://whereq:whereq@localhost:5432/whereq

# ── Security ─────────────────────────────────────────────────────────────
# Legacy local JWT settings. Kept for the password helpers only — the app
# does not issue its own sessions. Use a random 64-character value.
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Authentication (optional) ────────────────────────────────────────────
# Leave KEYCLOAK_URL EMPTY to run without authentication: the public
# browsing endpoints work and every protected endpoint answers 401.
# To enable sign-in, point these at your own OIDC realm — the walkthrough
# is in docs/SETUP.md.
KEYCLOAK_URL=
KEYCLOAK_REALM=whereq
KEYCLOAK_CLIENT_ID=whereq-spa
# Confidential service-account client (Admin REST API). Leave secret blank if unused.
KEYCLOAK_ADMIN_CLIENT_ID=whereq-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3743","http://localhost:5173"]

# ── Google Maps ──────────────────────────────────────────────────────────
# Used as the geocoding fallback of last resort.
GOOGLE_MAPS_API_KEY=
# Server-side key for backend web-service calls (Geocoding, Places New, Routes,
# Static). Must be a SEPARATE key without an HTTP-referrer restriction — the SPA
# key above is referrer-locked, so server calls with it are blocked. Restrict
# this one by IP/API allowlist instead. Falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_KEY=

# ── whereq.cloud (the upstream the crawler pulls from) ─────────────────────
# Fuel stations and live prices. Public access is a demo preview (oldest 100
# rows); set a whereq.cloud key for the full, live dataset. The key is used
# server-side only — it never reaches the browser.
WHEREQ_CLOUD_API_KEY=

# ── Fuel stations (whereq.cloud) ─────────────────────────────────────────
# Coverage targets, crawled round-robin so one tick never pulls everything.
# One of: CC | CC:State | CC:State:Municipality | bbox:minLon,minLat,maxLon,maxLat
FUEL_CRAWL_ENABLED=true
FUEL_CRAWL_TARGETS=CA,US
FUEL_CRAWL_TARGETS_PER_TICK=1
FUEL_CRAWL_CHECK_SECONDS=3600
FUEL_CRAWL_INTERVAL_HOURS=6
# Rows per API page (max 500) and the safety cap per target crawl.
FUEL_CRAWL_PAGE_SIZE=500
FUEL_CRAWL_MAX_STATIONS=60000
# The fuel API allows 30 requests/minute per key; we self-throttle below that.
FUEL_CRAWL_MIN_INTERVAL=2.2
FUEL_CRAWL_MAX_RETRIES=5
WHEREQ_CLOUD_TIMEOUT=60
# Aggregated price series (EIA weekly US / StatCan monthly CA / CRE MX).
FUEL_PRICES_ENABLED=true
FUEL_PRICES_REGIONS=ca,us
FUEL_PRICES_INTERVAL_HOURS=24
FUEL_PRICES_CHECK_SECONDS=3600

# ── Administrative geography (whereq.cloud) ──────────────────────────────
# The places that *contain* the places the map draws, with real outlines.
GEO_CRAWL_ENABLED=true
GEO_CRAWL_TARGETS=bbox:-80.3,43.6,-79.2,44.2
GEO_CRAWL_TARGETS_PER_TICK=1
GEO_CRAWL_CHECK_SECONDS=21600
GEO_CRAWL_INTERVAL_HOURS=168
GEO_CRAWL_PAGE_SIZE=200
GEO_CRAWL_MAX_PLACES=5000
GEO_CRAWL_FETCH_BOUNDARIES=true
GEO_CRAWL_MIN_INTERVAL=2.2
GEO_CRAWL_MAX_RETRIES=5
GEO_BOUNDARY_SIMPLIFY_M=50.0

# ── OpenStreetMap POIs (Overpass) ────────────────────────────────────────
# The map's Local Essentials and Quick Categories. The crawler re-crawls only
# when the newest OSM row is older than the interval.
POI_CRAWL_ENABLED=true
POI_CRAWL_CHECK_SECONDS=86400
POI_CRAWL_INTERVAL_DAYS=7

# ── Geocoding ────────────────────────────────────────────────────────────
# Multi-provider, free tiers first then Google. Set a key for each free
# provider you want to use; unconfigured providers are skipped.
GEOCODE_PROVIDER_ORDER=geocode_maps_co,locationiq,geocodio,nominatim,google
GEOCODE_REGION_BIAS=ca
GEOCODE_COUNTRY=CA
NOMINATIM_EMAIL=
NOMINATIM_RPS=1.0
GEOCODIO_API_KEY=
LOCATIONIQ_API_KEY=
GEOCODE_MAPS_CO_API_KEY=

# ── Crawler scheduler ────────────────────────────────────────────────────
CRAWLER_ENABLED=true
CRAWLER_TICK_SECONDS=300
CRAWLER_RETENTION_SECONDS=3600
CRAWLER_SEED_ON_START=true
