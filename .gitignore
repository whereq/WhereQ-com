# Build outputs
frontend/dist/
dist-ssr/
*.local

# ─── Secrets ──────────────────────────────────────────────────────────────
# Real values never belong in the repository. The *.example templates are
# tracked on purpose — the negation at the end re-includes them.
.env
.env.*
!.env.example
docker/.env
backend/.env
frontend/.env

# ─── Local data / databases ────────────────────────────────────────────────
*.sqlite3
*.db
pgdata/
data/postgres/
backups/
*.sql.gz

# ─── Tooling / editors ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Agent / editor settings — machine-local, never shared
.claude/
